FOR i = 1 TO 10 STEP 3: PRINT i;: NEXT: PRINT
FOR i = 3 TO 1 STEP -1
  PRINT i;
NEXT i
PRINT
FOR i = 1 TO 0: PRINT "never": NEXT
n = 0
WHILE n < 3
  n = n + 1
WEND
PRINT "while"; n
DO
  n = n - 1
LOOP UNTIL n = 0
PRINT "do"; n
DO WHILE n < 5: n = n + 2: LOOP
PRINT "do while"; n
FOR i = 1 TO 5
  IF i = 2 THEN CONTINUE FOR
  IF i = 4 THEN EXIT FOR
  PRINT "i"; i
NEXT
FOR v = 1 TO 12 STEP 5
  SELECT CASE v
    CASE 1, 2: PRINT v; " one or two"
    CASE 3 TO 7: PRINT v; " three to seven"
    CASE IS >= 10: PRINT v; " ten or more"
  END SELECT
NEXT
SELECT CASE "b"
  CASE "a": PRINT "a"
  CASE ELSE: PRINT "else"
END SELECT
x = 5
IF x > 10 THEN
  PRINT "big"
ELSEIF x > 3 THEN
  PRINT "medium"
ELSE
  PRINT "small"
END IF
IF x = 5 THEN PRINT "five" ELSE PRINT "not five"
IF x = 6 THEN PRINT "six" ELSE PRINT "not six": PRINT "same line"
k = 0
again:
k = k + 1
IF k < 3 THEN GOTO again
PRINT "goto"; k
total = 0 _
  + 1 _
  + 2
PRINT "continued"; total
