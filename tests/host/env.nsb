' environment variables: separate from BASIC variables
PRINT "path="; ENV$("path")
PRINT "cwd="; ENV$("CWD")
SETENV "greeting", "ciao"
greeting$ = "basic variable"
PRINT ENV$("greeting"), greeting$
RUN "set greeting"
RUN "set -v tmpvar uno due"
PRINT "["; ENV$("tmpvar"); "]"
x$ = ENV$("missing")
PRINT "missing ERR="; ERR
RUN "set -d tmpvar"
PRINT "deleted: ["; ENV$("tmpvar"); "] ERR="; ERR
RUN "set cwd x"
PRINT "readonly ERR="; ERR
RUN "nosuch"
PRINT "lasterror="; ENV$("lasterror")
' commands are found through "path"
RUN "mkdir tools"
WRITEFILE "tools\hello.nsb", "PRINT ""hello from path, arg="" + ARG$(1)"
RUN "hello x"
SETENV "path", ENV$("path") + ";tools"
RUN "hello x"
PRINT "uefishellversion="; ENV$("uefishellversion")
